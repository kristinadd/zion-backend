#!/bin/bash
# Start Envoy Sidecar for Rails App (Egress Proxy)
# This sidecar handles OUTBOUND traffic from Rails to other services

echo "🚀 Starting Rails Envoy Sidecar (Egress)..."
echo "📤 Handles outbound traffic from Rails app"
echo "🔌 Listening on: http://localhost:15001"
echo "📊 Admin UI: http://localhost:9901"
echo ""
echo "Press Ctrl+C to stop"
echo ""

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Start Envoy with config
envoy -c "$PROJECT_ROOT/envoy/envoy.yaml"

